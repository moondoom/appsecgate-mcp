# AppSecGate master + edge — переменные для корневого docker-compose.yml.
# Скопируйте в .env и замените ключи (пример: openssl rand -hex 32).

# JSON {"project-id": "key"} — карта проектов master (обязателен).
APPSECGATE_MASTER_API_KEYS={"my-project":"CHANGE-ME-32-hex-chars"}

# Ключ edge для синхронизации ОДНОГО проекта (совпадает с ключом выше).
APPSECGATE_MASTER_API_KEY=CHANGE-ME-32-hex-chars

# ID проекта на master (ключ из APPSECGATE_MASTER_API_KEYS).
APPSECGATE_PROJECT_ID=my-project

# Каталог локальных БД edge на хосте (по умолчанию ~/.appsecgate-mcp).
# APPSECGATE_DATA_DIR=/home/user/.appsecgate-mcp
