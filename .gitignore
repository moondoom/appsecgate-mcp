# ============================================================
# AppSecGate MCP — .gitignore
# ============================================================

# --- Python: байткод и кэши ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Сборка и упаковка ---
build/
dist/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- BuildKit local cache ---
.buildx-cache/

# --- Виртуальные окружения ---
# uv.lock и .python-version НЕ игнорируем — нужны для воспроизводимых сборок
.venv/
venv/
env/
ENV/

# --- Тесты и линтеры ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Рантайм-данные AppSecGate (локальный контур) ---
*.db
*.sqlite
*.sqlite3
shown_findings.db
feedback.db
scan_cache.db

# --- Секреты и локальная конфигурация ---
.env
.env.*
!.env.example
.appsecgate-mcp/
*.pem
*.key
credentials
*.token

# --- IDE / редакторы ---
.vscode/
.idea/
*.swp
*.swo
*~
.continue/

# --- ОС ---
.DS_Store
Thumbs.db
desktop.ini

# --- Логи и временные файлы ---
*.log
*.tmp
tmp/
# E2E-харнесс: машинные артефакты прогонов (результаты дублируются в docs/E2E-report)
scripts/e2e-results*.json

# TP-0001: внешние клоны, секреты и машинные артефакты стенда
experiments/tp-0001/repos/
experiments/tp-0001/runtime/
experiments/tp-0001/artifacts/
experiments/tp-0001/progress.json
experiments/tp-0001/stage2-freeze.json

experiments/tp-0001/fixtures/private-map.json
